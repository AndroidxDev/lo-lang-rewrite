+main = {
  # Parallel pipeline ~>> across CPU worker threads
  sq_sum = 1..=100
    ~>> { @ * @ }
    ~> (acc = 0) { acc + @ }
  println("par_sq_sum={sq_sum}")

  # Async green tasks ~>{ ... } and <~ await
  task1 = ~>{
    1..=10 ~> (s = 0) { s + @ }
  }
  task2 = ~>{
    6 * 7
  }
  [v1, v2] = [<~ task1, <~ task2]
  println("tasks={v1},{v2}")

  # Typed channel [~i64]() with producer task & @ (msg <- <~ ch) loop
  ch = [~i64]()
  producer = ~>{
    1..=5 ~> { ch <~ (@ * 10) }
    ch.close()
    5
  }

  chan_sum ~= 0
  count ~= 0
  @ (msg <- <~ ch) {
    chan_sum +<- msg
    count +<- 1
  }
  sent = <~ producer
  println("chan={sent}:{count}:{chan_sum}")
}
